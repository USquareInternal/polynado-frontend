# WalletConnect Cloud Project ID (REQUIRED)
# Get your projectId from https://cloud.walletconnect.com/
# Sign up for free and create a new project to get your projectId
NEXT_PUBLIC_PROJECT_ID=your-walletconnect-project-id-here

# Chain Configuration (REQUIRED)
# Options: bsc, bscTestnet, polygon, polygonAmoy, avax, avaxFuji, sonic, sonicTestnet, anvil
NEXT_PUBLIC_APPKIT_CHAIN_ID=bscTestnet

# App Title
NEXT_PUBLIC_TITLE=Polynado

# Optional: UI Theme Customization
# NEXT_PUBLIC_BTN_PRIMARY=#DB7A23
# NEXT_PUBLIC_BTN_TEXT=#ffffff
# NEXT_PUBLIC_CONNECT_WALLET_BUTTON_BORDER_RADIUS=100px
# NEXT_PUBLIC_FONT_FAMILY='Poppins', sans-serif
NEXT_PUBLIC_USDT_ADDRESS=0xed24fc36d5ee211ea25a80239fb8c4cfd80f12ee
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0xEC947E18eD5E24355B2f6d75E044AfAb7413b191